# Path to Cursor's projects directory.
# Must be an absolute path and already exist.
# Example: /home/you/.cursor/projects
# Windows example: C:/Users/YourName/.cursor/projects
CURSOR_PROJECTS_ROOT=/absolute/path/to/.cursor/projects

# Directory where exported files are written.
# Must be an absolute path; files will be created inside this directory.
# Example: /home/you/cursor-chat-exports
# Windows example: C:/Users/YourName/cursor-chat-exports
CURSOR_EXPORT_OUTPUT_ROOT=/absolute/path/to/cursor-chat-exports

# Directory for exporter state (checkpoints, metadata, etc.).
# Must be an absolute path; this directory should be writable.
# Example: /home/you/.local/state/cursor-chat-export
# Windows example: C:/Users/YourName/AppData/Local/cursor-chat-export
CURSOR_EXPORT_STATE_DIR=/absolute/path/to/.local/state/cursor-chat-export

# Optional settings

# Python executable used to run the exporter.
# Example values: python3, /usr/bin/python3, /opt/venv/bin/python
# Windows example value: python
CURSOR_EXPORT_PYTHON_BIN=python3

# Lock file to prevent overlapping runs.
# Use an absolute path in a writable temp/runtime directory.
# Example: /tmp/cursor-chat-export.lock
# Windows example: C:/Users/YourName/AppData/Local/Temp/cursor-chat-export.lock
# Note: run_cursor_export.ps1 defaults this to $env:TEMP if omitted.
CURSOR_EXPORT_LOCK_FILE=/tmp/cursor-chat-export.lock

# Desktop notifications (optional). Set CURSOR_EXPORT_NOTIFY=1 to enable when not using --notify.
# CURSOR_EXPORT_NOTIFY=1
# CURSOR_EXPORT_NOTIFY_WHEN=new_data
#   new_data — notify only when new entries were exported or on baseline init
#   always   — notify after every successful run (including zero new entries)
